<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<HBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.libreria.controller.GestionUsuariosController"
      spacing="30">

    <padding>
        <Insets top="30"
                right="30"
                bottom="30"
                left="30"/>
    </padding>

    <!-- ====================================== -->
    <!-- FORMULARIO DE REGISTRO -->
    <!-- ====================================== -->

    <VBox spacing="12"
          prefWidth="400">

        <Label text="GESTIÓN DE USUARIOS"
               style="-fx-font-size: 22px; -fx-font-weight: bold;"/>

        <Label text="Nombre de usuario"/>

        <TextField fx:id="txtUsername"
                   promptText="Ingrese el nombre de usuario"
                   maxWidth="350"/>

        <Label text="Contraseña"/>

        <PasswordField fx:id="txtPassword"
                       promptText="Ingrese la contraseña"
                       maxWidth="350"/>

        <Label text="Confirmar contraseña"/>

        <PasswordField fx:id="txtConfirmarPassword"
                       promptText="Repita la contraseña"
                       maxWidth="350"/>

        <Label text="Rol"/>

        <ComboBox fx:id="cmbRol"
                  promptText="Seleccione un rol"
                  maxWidth="350"/>

        <Button fx:id="btnRegistrar"
                text="Registrar usuario"
                onAction="#handleRegistrar"
                maxWidth="350"/>

        <Button fx:id="btnLimpiar"
                text="Limpiar"
                onAction="#handleLimpiar"
                maxWidth="350"/>

        <Button fx:id="btnRegresar"
                text="Regresar"
                onAction="#handleRegresar"
                maxWidth="350"/>

    </VBox>


    <!-- ====================================== -->
    <!-- LISTA DE USUARIOS -->
    <!-- ====================================== -->

    <VBox spacing="12"
          prefWidth="400"
          VBox.vgrow="ALWAYS">

        <Label text="USUARIOS REGISTRADOS"
               style="-fx-font-size: 22px; -fx-font-weight: bold;"/>

        <Label text="Lista de usuarios existentes"/>

        <ListView fx:id="lstUsuarios"
                  VBox.vgrow="ALWAYS"/>

    </VBox>

</HBox>