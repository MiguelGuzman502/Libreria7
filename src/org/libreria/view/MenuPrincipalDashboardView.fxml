<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefWidth="900.0" prefHeight="600.0" style="-fx-background-color: #FFFFFF;" 
            xmlns="http://javafx.com/javafx/21" 
            xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="org.libreria.controller.MenuPrincipalDashboardController">

    <top>
        <HBox alignment="CENTER_LEFT" style="-fx-border-color: #000000; -fx-border-width: 0 0 1 0; -fx-background-color: #FFFFFF;" prefHeight="60.0">
            <padding><Insets left="20" right="20"/></padding>
            <Label fx:id="lblUsuarioHeader" text="○ Usuario / Rol" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #000000;" />
            <HBox HBox.hgrow="ALWAYS" />
            <Button text="Cerrar Sesión" onAction="#handleCerrarSesion" 
                    style="-fx-background-color: #FFFFFF; -fx-border-color: #000000; -fx-border-width: 1px; -fx-text-fill: #000000; -fx-cursor: hand;" 
                    prefWidth="110.0" prefHeight="32.0" />
        </HBox>
    </top>

    <left>
        <VBox fx:id="vboxNavegacion" spacing="15.0" prefWidth="180.0" 
              style="-fx-border-color: #000000; -fx-border-width: 0 1 0 0; -fx-background-color: #FFFFFF;">
            <padding><Insets top="20" right="10" bottom="20" left="15"/></padding>
            <Label text="Navegación" style="-fx-font-weight: bold; -fx-text-fill: #000000; -fx-font-size: 14px;" />
        </VBox>
    </left>

    <center>
        <VBox spacing="20.0" style="-fx-background-color: #FFFFFF;">
            <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
            <VBox spacing="3.0">
                <Label fx:id="lblTituloPanel" text="¡Panel de Control!" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #000000;" />
                <Label fx:id="lblSubtituloPanel" text="Gestión del sistema" style="-fx-text-fill: #555555; -fx-font-size: 12px;" />
            </VBox>

            <FlowPane fx:id="containerTarjetas" hgap="20.0" vgap="20.0" prefWrapLength="650.0">
            </FlowPane>
        </VBox>
    </center>
</BorderPane>