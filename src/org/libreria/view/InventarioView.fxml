<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.libreria.controller.InventarioController" prefWidth="1100" prefHeight="700">
    <top>
        <HBox spacing="12" alignment="CENTER_LEFT">
            <padding><Insets top="15" right="20" bottom="15" left="20"/></padding>
            <Label text="Inventario" styleClass="title" HBox.hgrow="ALWAYS"/>
            <Button text="Actualizar" onAction="#handleActualizar"/>
            <Button text="Regresar" onAction="#handleRegresar"/>
        </HBox>
    </top>
    <center>
        <TableView fx:id="tablaInventario">
            <columns>
                <TableColumn fx:id="colIsbn" text="ISBN" prefWidth="190"/>
                <TableColumn fx:id="colTitulo" text="Título" prefWidth="300"/>
                <TableColumn fx:id="colAutor" text="Autor" prefWidth="220"/>
                <TableColumn fx:id="colPrecio" text="Precio" prefWidth="130"/>
                <TableColumn fx:id="colStock" text="Stock" prefWidth="100"/>
            </columns>
        </TableView>
    </center>
</BorderPane>
