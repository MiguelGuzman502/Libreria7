<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.libreria.controller.ComprobanteController" spacing="15" alignment="CENTER" prefWidth="620" prefHeight="700">
    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
    <Label text="COMPROBANTE DE VENTA" style="-fx-font-size: 22px; -fx-font-weight: bold;"/>
    <TextArea fx:id="txtComprobante" editable="false" wrapText="false" prefWidth="570" prefHeight="590" style="-fx-font-family: monospace; -fx-font-size: 14px;" VBox.vgrow="ALWAYS"/>
    <HBox spacing="10" alignment="CENTER">
        <Button text="Imprimir" onAction="#handleImprimir" prefWidth="120"/>
        <Button fx:id="btnCerrar" text="Cerrar" onAction="#handleCerrar" prefWidth="120"/>
    </HBox>
</VBox>
