<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.libreria.controller.ComprobanteController"
      spacing="15"
      alignment="CENTER"
      prefWidth="500"
      prefHeight="650">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="COMPROBANTE DE VENTA"
           style="-fx-font-size: 22px; -fx-font-weight: bold;"/>

    <TextArea fx:id="txtComprobante"
              editable="false"
              wrapText="false"
              prefWidth="450"
              prefHeight="520"
              style="-fx-font-family: monospace; -fx-font-size: 14px;"/>

    <Button fx:id="btnCerrar"
            text="Cerrar"
            onAction="#handleCerrar"
            prefWidth="120"/>

</VBox>