<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.libreria.controller.EntradaStockController" prefWidth="1100" prefHeight="700" styleClass="dashboard">
    <top>
        <VBox spacing="12">
            <padding><Insets top="20" right="24" bottom="16" left="24"/></padding>
            <HBox spacing="12" alignment="CENTER_LEFT">
                <Label text="Entradas de bodega" styleClass="title" HBox.hgrow="ALWAYS"/>
                <Button text="Actualizar" onAction="#handleActualizar"/>
                <Button text="Regresar" onAction="#handleRegresar"/>
            </HBox>
            <HBox spacing="12" alignment="CENTER_LEFT">
                <TextField fx:id="txtBuscar" promptText="Buscar por título o ISBN" prefWidth="360" HBox.hgrow="ALWAYS"/>
                <TextField fx:id="txtCantidad" promptText="Cantidad" prefWidth="130"/>
                <Button text="Agregar al stock" onAction="#handleAgregar"/>
            </HBox>
        </VBox>
    </top>
    <center>
        <TableView fx:id="tablaLibros">
            <columns>
                <TableColumn fx:id="colIsbn" text="ISBN" prefWidth="220"/>
                <TableColumn fx:id="colTitulo" text="Título" prefWidth="390"/>
                <TableColumn fx:id="colAutor" text="Autor" prefWidth="300"/>
                <TableColumn fx:id="colStock" text="Stock actual" prefWidth="130"/>
            </columns>
        </TableView>
    </center>
</BorderPane>
