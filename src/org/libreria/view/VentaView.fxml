<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.libreria.controller.VentaController" prefWidth="1100.0" prefHeight="700.0" styleClass="venta-view">
    <top>
        <HBox spacing="15" alignment="CENTER_LEFT" styleClass="header">
            <padding><Insets top="15" right="20" bottom="15" left="20"/></padding>
            <children>
                <Label text="Nueva Venta" styleClass="title" HBox.hgrow="ALWAYS"/>
                <Button text="Regresar" onAction="#handleRegresar" styleClass="secondary-button"/>
            </children>
        </HBox>
    </top>
    <center>
        <VBox spacing="12" styleClass="content">
            <padding><Insets top="18" right="25" bottom="18" left="25"/></padding>
            <VBox spacing="8">
                <Label text="Buscar libros" styleClass="section-title"/>
                <HBox spacing="10">
                    <TextField fx:id="txtBuscar" promptText="Título, autor o ISBN..." HBox.hgrow="ALWAYS"/>
                    <Button text="Buscar" onAction="#handleBuscar" styleClass="primary-button"/>
                    <Button text="Limpiar" onAction="#handleLimpiarBusqueda" styleClass="secondary-button"/>
                </HBox>
            </VBox>
            <VBox spacing="8" VBox.vgrow="ALWAYS">
                <Label text="Libros disponibles" styleClass="section-title"/>
                <TableView fx:id="tablaLibros" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colId" text="ID" prefWidth="50"/>
                        <TableColumn fx:id="colIsbn" text="ISBN" prefWidth="150"/>
                        <TableColumn fx:id="colTitulo" text="Título" prefWidth="220"/>
                        <TableColumn fx:id="colAutor" text="Autor" prefWidth="190"/>
                        <TableColumn fx:id="colPrecio" text="Precio" prefWidth="100"/>
                        <TableColumn fx:id="colStock" text="Stock" prefWidth="70"/>
                    </columns>
                </TableView>
                <Button text="Agregar al carrito" onAction="#handleAgregarCarrito" styleClass="primary-button"/>
            </VBox>
            <VBox spacing="8">
                <Label text="Carrito de venta" styleClass="section-title"/>
                <TableView fx:id="tablaCarrito" prefHeight="150">
                    <columns>
                        <TableColumn fx:id="colCarritoTitulo" text="Producto" prefWidth="270"/>
                        <TableColumn fx:id="colCarritoPrecio" text="Precio" prefWidth="110"/>
                        <TableColumn fx:id="colCarritoCantidad" text="Cantidad" prefWidth="100"/>
                        <TableColumn fx:id="colCarritoSubtotal" text="Subtotal" prefWidth="120"/>
                    </columns>
                </TableView>
                <HBox spacing="10">
                    <Button text="− Cantidad" onAction="#handleDisminuirCantidad" styleClass="secondary-button"/>
                    <Button text="+ Cantidad" onAction="#handleAumentarCantidad" styleClass="secondary-button"/>
                    <Button text="Eliminar" onAction="#handleEliminarCarrito" styleClass="danger-button"/>
                    <Button text="Vaciar carrito" onAction="#handleVaciarCarrito" styleClass="danger-button"/>
                    <VBox HBox.hgrow="ALWAYS"/>
                    <VBox alignment="CENTER_RIGHT" spacing="4">
                        <HBox spacing="10"><Label text="Subtotal:" styleClass="total-label"/><Label fx:id="lblSubtotal" text="Q 0.00" styleClass="total-value"/></HBox>
                        <HBox spacing="10"><Label text="TOTAL:" styleClass="total-label"/><Label fx:id="lblTotal" text="Q 0.00" styleClass="total-value"/></HBox>
                    </VBox>
                </HBox>
                <HBox spacing="10" alignment="CENTER_RIGHT">
                    <Label text="CUI cliente:"/>
                    <TextField fx:id="txtCuiCliente" promptText="Opcional" prefWidth="170"/>
                    <Button text="Registrar venta" onAction="#handleRegistrarVenta" styleClass="primary-button"/>
                </HBox>
            </VBox>
        </VBox>
    </center>
</BorderPane>
