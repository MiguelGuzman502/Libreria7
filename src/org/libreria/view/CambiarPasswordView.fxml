<?xml version="1.0" encoding="UTF-8"?>
 
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.layout.VBox?>
 
<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.libreria.controller.CambiarPasswordController"
      spacing="12">
 
    <padding>
<Insets top="30"
                right="30"
                bottom="30"
                left="30"/>
</padding>
 
    <Label text="CAMBIAR CONTRASEÑA"/>
 
    <Label text="Contraseña actual"/>
 
    <PasswordField fx:id="txtPasswordActual"
                   promptText="Ingrese contraseña actual"
                   maxWidth="300"/>
 
    <Label text="Nueva contraseña"/>
 
    <PasswordField fx:id="txtPasswordNueva"
                   promptText="Ingrese nueva contraseña"
                   maxWidth="300"/>
 
    <Label text="Confirmar nueva contraseña"/>
 
    <PasswordField fx:id="txtConfirmarPassword"
                   promptText="Confirme nueva contraseña"
                   maxWidth="300"/>
 
    <Button text="Cambiar contraseña"
            onAction="#handleCambiarPassword"
            maxWidth="300"/>
 
    <Button text="Regresar"
            onAction="#handleCancelar"
            maxWidth="300"/>
 
</VBox>